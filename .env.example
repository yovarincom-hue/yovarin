# ==============================================================================
# Yovarin Technologies — Environment Configuration Example
# Account: yovarin.com@gmail.com
# ==============================================================================

# Gmail SMTP / Nodemailer Credentials
# Used for local Node.js deployments.
EMAIL_USER=yovarin.com@gmail.com
EMAIL_PASS=your-16-character-app-password
NOTIFICATION_EMAIL=yovarin.com@gmail.com

# Cloudflare Workers email delivery (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Cloudflare Turnstile form protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Authentication OTP integrity key (use a unique, random secret in production)
AUTH_SECRET=

# Yovarin Pilot (configure only for an approved OpenAI-compatible provider)
PILOT_AI_BASE_URL=https://your-provider.example/v1
PILOT_AI_MODEL=
PILOT_AI_API_KEY=
FRAPPE_BASE_URL=https://your-erp.example
FRAPPE_API_KEY=
FRAPPE_API_SECRET=
PILOT_ALLOWED_EMAILS=
