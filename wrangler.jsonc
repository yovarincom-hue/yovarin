{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yovarin",
  "workers_dev": true,
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "yovarin"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yovarin-db",
      "database_id": "bb2c5ab6-cdc8-4e84-9c37-287a8a0a6205",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
